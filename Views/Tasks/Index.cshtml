@model IEnumerable<DemoWeb.Models.Tasks>

@{
    ViewData["Title"] = "Tasks List";
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
 
    // Function to load a specific page of tasks
    function loadTaskPage(page, query) {
        $.ajax({
            url: '@Url.Action("GetTaskList", "Tasks")',
            type: 'GET',
            data: { page: page, query: query }
        })
            .done(function (data) {
                $('#taskListContainer').html(data);
            })
            .fail(function (jqXHR, textStatus, errorThrown) {
                console.error("Error loading task page:", textStatus, errorThrown);
                alert("An error occurred while loading the task page.");
            });
    }

    // Load the first page on initial load
    $(document).ready(function () {
        loadTaskPage(1, ''); // Loads the first page initially with no search query

        // Set up input event handler for search
        $('#taskSearch').on('input', function () {
            var query = $(this).val();

            // Load the first page with the search query
            loadTaskPage(1, query);
        });
    });
</script>




<div class="container mt-4">
    <h2>Task List</h2>

    <!-- Search input for filtering tasks -->
    <div class="mb-3">
        <input type="text" id="taskSearch" class="form-control" placeholder="Search tasks by title">
    </div>

    <div id="taskListContainer">
        <!-- Task list content will be loaded here via AJAX -->
    </div>
</div>
